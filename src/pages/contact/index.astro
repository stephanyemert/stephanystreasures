---
import Layout from '../../layouts/Layout.astro';

export const prerender = true;
export const ssr = false;

import '../../styles/contact.css'

import siteSettings from '../../../public/data/site-settings.json';
const contactEmail = siteSettings.contact.email;
---

<Layout 
  title="Contact Us" 
  description="Get in touch with Stephany's Treasures."
  keywords="contact, Stephany's Treasures"
  author="Stephany's Treasures"
  color="#ff69b4"
  contact="true"
>
  <main class="container mb-5">

    <h1 class="text-center mb-4 fw-light">Contact Stephany's Treasures</h1>
    <p class="text-center text-muted mb-5">
      Have a question, custom request, or need help with an order?  
      Send us a message and we’ll get back to you soon.
    </p>

    <form 
      name="Contact Form"
      method="POST"
      action="/contact/success"
      data-netlify-honeypot="bot-field"
      enctype="multipart/form-data"
      class="mx-auto p-4 border rounded-3 shadow-sm"
      style="max-width: 600px;"
      data-netlify="true"
    >
      <input type="hidden" name="form-name" value="Contact Form">
      <input type="hidden" name="bot-field">

      <!-- Name -->
      <div class="form-floating mb-3">
        <input 
          type="text" 
          class="form-control" 
          id="name" 
          name="name" 
          placeholder="Your Name"
          required
        >
        <label for="name">Your Name</label>
      </div>

      <!-- Email -->
      <div class="form-floating mb-3">
        <input 
          type="email" 
          class="form-control" 
          id="email" 
          name="email" 
          placeholder="Your Email"
          required
        >
        <label for="email">Your Email</label>
      </div>

      <!-- Message -->
      <div class="form-floating mb-3">
        <textarea 
          class="form-control" 
          placeholder="Your Message" 
          id="message" 
          name="message" 
          style="height: 150px"
          required
        ></textarea>
        <label for="message">Message</label>
      </div>

      <div class="mb-4">
        <label 
          for="attachment" 
          id="attachment-label"
          tabindex="0"
          class="form-control file-box d-flex justify-content-between align-items-center small"
        >
          <span class="text-muted">Attach a File (optional)</span>
          <span id="attachment-filename" class="text-end text-break">Select a File</span>
        </label>
        <div id="attachment-feedback" class="invalid-feedback d-none">
          File must be 10MB or smaller.
        </div>
        <input 
          type="file" 
          id="attachment" 
          name="file" 
          class="d-none"
          accept="image/*,video/*,audio/*"
        >
      </div>

      <!-- Submit -->
      <div class="text-center">
        <button type="submit" class="btn btn-primary btn-lg px-4">
          Send Message
        </button>
      </div>
    </form>

    <div class="text-center mt-4">
      <p class="text-muted">
        Prefer email instead? You can also reach us at  
        <strong><a href={`mailto:${contactEmail}`}>{contactEmail}</a></strong>
      </p>
    </div>

  </main>
</Layout>
