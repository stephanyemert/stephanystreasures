---
import Layout from '../layouts/Layout.astro';
import Stripe from 'stripe';
import { markSoldOut } from '../lib/soldOut';

const stripe = new Stripe(import.meta.env.STRIPE_SECRET_KEY);

const sessionId = Astro.url.searchParams.get('session_id');
let error = false;

if (sessionId) {
  try {
    const session = await stripe.checkout.sessions.retrieve(sessionId);

    // Only mark sold out if payment actually completed
    if (session.payment_status === 'paid') {
      const productIds = session.metadata?.product_ids;
      if (productIds) {
        const ids = productIds.split(',').map((id: string) => id.trim()).filter(Boolean);
        for (const id of ids) {
          await markSoldOut(id);
          console.log(`Marked sold out: ${id}`);
        }
      }
    }
  } catch (err) {
    console.error('Failed to retrieve session:', err);
    error = true;
  }
}
---

<Layout 
  title="Payment Successful" 
  description="Your payment was processed successfully."
  keywords="success, payment, confirmation"
  author="Stephany's Treasures"
  color="#ff69b4"
>
  <main id="success-page">
    <div class="text-center mb-4 rounded-2 hero shadow">
      <div class="hero-back rounded-2 py-5">
        <i class="bi bi-check-circle-fill text-success fs-1"></i>
        <h1 class="title fw-light lh-1 mt-3">Thank You!</h1>
        <p class="fs-5 m-3 mb-0 text-body-secondary">
          Your payment was successful.
        </p>
      </div>
    </div>

    <div class="container text-center my-5">
      <a href="/" class="btn btn-primary btn-lg">
        Return Home
        <i class="bi bi-arrow-right ms-2"></i>
      </a>

      <hr class="mx-2 mt-5">

      <p class="figure-caption">
        We will contact you regarding shipping soon.
        Please allow time for processing.
      </p>
    </div>
  </main>

  <!-- Clear the cart on successful purchase -->
  <script>
    localStorage.removeItem('cart');
  </script>
</Layout>